{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static",
      "config": {
        "distDir": "public"
      }
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/config",
      "dest": "/api/config.js"
    },
    {
      "src": "/api/beta",
      "dest": "/api/beta.js"
    },
    {
      "src": "/api/beta-admin",
      "dest": "/api/beta-admin.js"
    },
    {
      "src": "/api/beta-admin-maintenance",
      "dest": "/api/beta-admin-maintenance.js"
    },
    {
      "src": "/api/backup",
      "dest": "/api/backup.js"
    },
    {
      "src": "/api/strava/(.*)",
      "dest": "/api/strava.js"
    },
    {
      "src": "/api/coach",
      "dest": "/api/coach.js"
    },
    {
      "src": "/api/weather",
      "dest": "/api/weather.js"
    },
    {
      "src": "/api/delete-account",
      "dest": "/api/delete-account.js"
    },
    {
      "src": "/api/stripe-checkout",
      "dest": "/api/stripe-checkout.js"
    },
    {
      "src": "/api/stripe-webhook",
      "dest": "/api/stripe-webhook.js"
    },

    {
      "src": "/v2",
      "dest": "/public/v2/index.html"
    },
    {
      "src": "/v2/",
      "dest": "/public/v2/index.html"
    },

    {
      "src": "/beta",
      "dest": "/public/beta/index.html"
    },
    {
      "src": "/beta/",
      "dest": "/public/beta/index.html"
    },

    {
      "src": "/beta-admin",
      "dest": "/public/beta-admin/index.html"
    },
    {
      "src": "/beta-admin/",
      "dest": "/public/beta-admin/index.html"
    },

    {
      "src": "/(.*)",
      "dest": "/public/$1",
      "headers": {
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "X-Content-Type-Options": "nosniff",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js-de.sentry-cdn.com https://browser.sentry-cdn.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://esm.sh; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://oppwuzbcnhchtokxpzla.supabase.co wss://oppwuzbcnhchtokxpzla.supabase.co https://*.strava.com https://sentry.io https://*.sentry.io https://*.ingest.sentry.io https://*.stripe.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://esm.sh; frame-src https://*.stripe.com; frame-ancestors 'self'"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/backup",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "0 20 * * *"
    }
  ]
}
